# Backend Google Gemini API secret key for weather search grounding
GEMINI_API_KEY=

# Optional Garmin Connect Personal API Key (https://developer.garmin.com/gc-developer-program/personal/personal-api)
GARMIN_PERSONAL_API_KEY=

# Optional master secret for AES-256-GCM encryption of the stored Garmin Personal API Key at rest
GARMIN_KEY_ENCRYPTION_SECRET=
